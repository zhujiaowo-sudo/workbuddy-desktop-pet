{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkBuddy Desktop Pet character packs v1/v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "author",
    "version",
    "license",
    "actions"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quality": {
      "enum": [
        "light",
        "hd"
      ],
      "default": "light"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": 1
        },
        "actions": {
          "type": "object",
          "required": [
            "idle"
          ],
          "maxProperties": 7,
          "propertyNames": {
            "enum": [
              "idle",
              "thinking",
              "working",
              "waiting",
              "review",
              "done",
              "failed"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 240,
                "pattern": "\\.(png|gif|webp)$"
              },
              "loop": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    },
    {
      "required": [
        "quality"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "actions": {
          "type": "object",
          "required": [
            "idle",
            "thinking",
            "working",
            "waiting",
            "review",
            "done",
            "failed",
            "click_wave",
            "click_heart",
            "click_shy",
            "click_surprised",
            "leisure_snack",
            "leisure_phone",
            "leisure_stretch",
            "leisure_music"
          ],
          "additionalProperties": false,
          "properties": {
            "idle": {
              "type": "object",
              "required": [
                "file",
                "loop"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^actions/idle\\.(webp|png|gif)$"
                },
                "loop": {
                  "const": true
                }
              }
            },
            "thinking": {
